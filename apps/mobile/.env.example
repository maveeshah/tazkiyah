# Copy to .env.local and adjust for your environment.
#
# Base URL of the Tazkiyah FastAPI backend, including the /api/v1 prefix.
# - Simulator / emulator on the same machine: http://localhost:8000/api/v1
# - Physical device (Expo Go): use the host machine's LAN IP, e.g.
#   http://192.168.1.20:8000/api/v1  ("localhost" on a phone means the phone itself)
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
